<?xml version="1.0" encoding="utf-8"?>
<resources>
  <color name="background">#eae7de</color>
  <color name="accent">#a93718</color>
  <bool name="light_bars">true</bool>
  <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:colorAccent">@color/accent</item>
    <item name="android:windowBackground">@color/background</item>
    <item name="android:statusBarColor">@color/background</item>
    <item name="android:navigationBarColor">@color/background</item>
    <item name="android:windowLightStatusBar">@bool/light_bars</item>
    <item name="android:windowLightNavigationBar">@bool/light_bars</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:forceDarkAllowed">false</item>
  </style>
  <style name="AppTheme" parent="AppThemeBase" />
  <style name="AppThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowBackground">#eae7de</item>
    <item name="android:colorAccent">#a93718</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:forceDarkAllowed">false</item>
  </style>
  <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowBackground">#10151a</item>
    <item name="android:colorAccent">#ff7952</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:forceDarkAllowed">false</item>
  </style>
</resources>
